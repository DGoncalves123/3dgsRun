# ============================================================
# 3D Gaussian Splatting Pipeline Configuration
# ============================================================

# -- Frame Curation (scripts/extract_frames.py) --
# Sampling rate. Dense sampling gives the curator more chances to catch the
# occasional SHARP frame in a blurry walkthrough. 6 fps on a 3-minute video
# yields ~1100 candidates before curation.
EXTRACT_FPS=6

# JPEG quality for the curated frames (cv2 scale: 1-100, higher = better).
FRAME_JPEG_QUALITY=95

# Sharpness floor. Frames below this are rejected as too blurry for COLMAP.
#   0 = auto-tune: floor = FRAME_SHARPNESS_RATIO * (99th-percentile sharpness)
#   >0 = use this absolute Laplacian-variance value directly.
FRAME_MIN_SHARPNESS=0

# Auto floor ratio (only used when FRAME_MIN_SHARPNESS=0).
# Auto floor = FRAME_SHARPNESS_RATIO * (90th-percentile sharpness).
# Lower = keep more (softer) frames, higher = keep only the very sharpest.
FRAME_SHARPNESS_RATIO=0.25

# Reject frames darker than this mean brightness (0-255). 0 = off (dark room).
FRAME_MIN_BRIGHTNESS=0

# Minimum time between kept frames, in seconds. This is the de-duplicator for
# a walkthrough: it keeps the sharpest frame in each window and drops the rest.
# 0.5s works well; raise it if you have too many frames / too much overlap.
FRAME_MIN_GAP_SECONDS=0.5

# Hard cap on kept frames (0 = unlimited). Useful to bound COLMAP runtime.
FRAME_MAX_FRAMES=0

# Contrast enhancement (CLAHE). CRITICAL for dark rooms: it amplifies local
# contrast so SIFT can find features in otherwise flat/dark frames. Keep on.
FRAME_CLAHE=1
FRAME_CLAHE_CLIP=2.0
FRAME_CLAHE_GRID=8

# Optional light denoise before enhancement (fastNlMeans, slower). 0 = off.
FRAME_DENOISE=0

# Optional unsharp mask to crisp up soft edges. 1 = on (recommended).
FRAME_UNSHARP=1
FRAME_UNSHARP_AMOUNT=0.5

# -- COLMAP (Camera Pose Estimation) --
# Matcher type: "exhaustive" (best quality, recommended) or "sequential" (faster)
COLMAP_MATCHER="exhaustive"

# Camera model: OPENCV recommended for most cameras/phones
COLMAP_CAMERA_MODEL="OPENCV"

# Use single camera (1 = yes). Set to 1 since all frames come from one video.
COLMAP_SINGLE_CAMERA=1

# More SIFT features helps weak/low-contrast scenes (default 8192).
COLMAP_MAX_FEATURES=16384

# Guided matching re-runs matching for pairs already verified geometrically,
# which recovers more matches on blurry/weak imagery. 1 = on.
COLMAP_GUIDED_MATCHING=1

# GPU index for COLMAP (-1 = auto)
COLMAP_GPU_INDEX=-1

# -- 3DGS Training --
# Number of training iterations (30000 = full quality, 7000 = quick preview)
TRAIN_ITERATIONS=30000

# Image resolution factor: 1=full, 2=half, 4=quarter
# For 10GB VRAM, use 2 (half resolution). Use 4 if OOM occurs.
TRAIN_RESOLUTION=2

# Densification gradient threshold (default 0.0002; increase to 0.0004 if OOM)
TRAIN_DENSIFY_GRAD_THRESHOLD=0.0002

# Test set split: every Nth image is held out for evaluation (0 = no test split)
TRAIN_TEST_INTERVAL=8

# -- .ksplat Conversion --
# Compression level: 0=none, 1=16-bit quantization (recommended), 2=max compression
KSPLAT_COMPRESSION=1

# -- Paths (auto-configured by setup.sh, override if needed) --
TOOLS_DIR="./tools"
GAUSSIAN_SPLATTING_DIR="./tools/gaussian-splatting"
GAUSSIAN_SPLATS_3D_DIR="./tools/gaussian-splats-3d"
DATA_DIR="./data"
